# Copy to .env.local and fill in real values. Never commit .env.local.
# `pnpm db:status` prints the local values after `pnpm db:start`.

# Public project URL (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public anonymous key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Edge functions only. Never add this to either Next.js app.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# local | staging | production
APP_ENV=local

# Optional error tracking
SENTRY_DSN=
