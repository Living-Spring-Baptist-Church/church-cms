{
  "name": "church-cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=12.6.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:root",
    "lint:root": "eslint --max-warnings 0 .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:em-dash": "node scripts/check-em-dash.mjs",
    "duplicates": "jscpd",
    "verify": "node scripts/verify.mjs",
    "schema:export": "node scripts/export-graphql-schema.mjs",
    "codegen": "pnpm schema:export && pnpm codegen:generate",
    "codegen:generate": "graphql-codegen --config codegen.mjs",
    "codegen:check": "pnpm codegen:generate && node scripts/check-generated-files.mjs",
    "db:start": "pnpm --filter @lbc/db supabase start",
    "db:stop": "pnpm --filter @lbc/db supabase stop",
    "db:status": "pnpm --filter @lbc/db supabase status",
    "db:reset": "pnpm --filter @lbc/db supabase db reset",
    "db:test": "pnpm --filter @lbc/db supabase test db",
    "db:new": "pnpm --filter @lbc/db supabase migration new",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@graphql-codegen/add": "7.1.1",
    "@graphql-codegen/cli": "7.4.3",
    "@graphql-codegen/typed-document-node": "7.1.1",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.9",
    "@lbc/config": "workspace:*",
    "eslint": "9.39.5",
    "graphql": "17.0.2",
    "husky": "9.1.7",
    "jscpd": "5.4.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "6.0.3"
  }
}
